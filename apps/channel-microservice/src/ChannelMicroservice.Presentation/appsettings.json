{
  "Authentication": {
    "Issuer": "bizcord-local-gateway",
    "Audience": "channel-service"
  },
  "Vault": {
    "Address": "http://localhost:8200",
    "MessagingSecretPath": "v1/secret/data/channel-service/messaging",
    "MessagingSecretKey": "ConnectionString",
    "JwtSecretPath": "v1/secret/data/shared/jwt",
    "JwtSecretKey": "SigningKey",
    "Timeout": "00:00:05"
  },
  "Messaging": {
    "PublishTimeout": "00:00:05",
    "MaxConcurrentPublishes": 16
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
